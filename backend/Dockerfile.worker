FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libatomic1 \
    && rm -rf /var/lib/apt/lists/*

COPY voice_agent_requirements.txt .
RUN python -m pip install --upgrade pip && python -m pip install -r voice_agent_requirements.txt

COPY . .

CMD ["python", "voice_agent.py", "start"]
