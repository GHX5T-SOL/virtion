# Copy this file to `backend/.env.local` and fill in the values.
# The backend reads these at startup — restart the server after editing.
#
# WARNING: .env.local is gitignored. Never commit API keys.

# Anthropic API key for the Managed Agent (virtion-attending). Server-side only —
# never set this in a VITE_* variable and never return it to the browser.
ANTHROPIC_API_KEY=

# Optional direct-inference fallbacks. The backend tries configured providers
# in order before returning a deterministic local result for patient text,
# triage, and debrief fallback routes.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
VERCEL_AI_GATEWAY_API_KEY=
GEMINI_API_KEY=
CEREBRAS_API_KEY=
HUGGINGFACE_API_KEY=

# Optional model overrides.
ANTHROPIC_TRIAGE_MODEL=claude-opus-4-7
ANTHROPIC_DEBRIEF_MODEL=claude-opus-4-7
ANTHROPIC_PATIENT_MODEL=claude-haiku-4-5
OPENAI_TRIAGE_MODEL=gpt-4o-mini
OPENAI_DEBRIEF_MODEL=gpt-4o-mini
OPENAI_PATIENT_MODEL=gpt-4o-mini
OPENROUTER_TRIAGE_MODEL=openai/gpt-4o-mini
OPENROUTER_DEBRIEF_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_PATIENT_MODEL=openai/gpt-4o-mini
VERCEL_AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1/chat/completions
VERCEL_AI_GATEWAY_TRIAGE_MODEL=openai/gpt-4o-mini
VERCEL_AI_GATEWAY_DEBRIEF_MODEL=openai/gpt-4o-mini
VERCEL_AI_GATEWAY_PATIENT_MODEL=openai/gpt-4o-mini
GEMINI_TRIAGE_MODEL=gemini-2.0-flash-lite
GEMINI_DEBRIEF_MODEL=gemini-2.0-flash
GEMINI_PATIENT_MODEL=gemini-2.0-flash-lite
CEREBRAS_TRIAGE_MODEL=llama-3.3-70b
CEREBRAS_DEBRIEF_MODEL=llama-3.3-70b
CEREBRAS_PATIENT_MODEL=llama-3.1-8b

# Cached IDs for the persistent Managed Agent + Environment.
# First run: leave these blank, start the server, POST /agent/bootstrap,
# then paste the returned `agent_id` / `environment_id` back here and
# restart. Subsequent runs are no-ops.
VIRTION_AGENT_ID=
VIRTION_ENV_ID=

# LiveKit Cloud — https://cloud.livekit.io. Used by the FastAPI server
# to mint room JWTs and by voice_agent.py to register as a worker.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Deepgram — https://deepgram.com. Streaming STT inside the voice worker.
DEEPGRAM_API_KEY=

# Cartesia — https://cartesia.ai. Streaming TTS inside the voice worker.
CARTESIA_API_KEY=
CARTESIA_TTS_MODEL=sonic-2

# Voice fallbacks. The worker tries Cartesia, then ElevenLabs, then OpenAI TTS.
# LiveKit's ElevenLabs plugin expects ELEVEN_API_KEY; ELEVENLABS_API_KEY is
# accepted locally and mirrored at runtime for convenience.
ELEVEN_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_VOICE_ID_M=pNInz6obpgDQGcFmaJgB
ELEVENLABS_VOICE_ID_F=EXAVITQu4vr4xnSDxMaL
OPENAI_STT_MODEL=gpt-4o-transcribe
OPENAI_VOICE_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=ash

# Vercel/Netlify edge middleware -> backend proxy.
BACKEND_SHARED_SECRET=
VIRTION_BACKEND_URL=
NETLIFY_BACKEND_URL=
